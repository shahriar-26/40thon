def get_grade(marks):
    if marks >= 80:
        return "A"
    elif marks >= 65:
        return "B"
    elif marks >= 50:
        return "C"
    else:
        return "F"

print(get_grade(85))
print(get_grade(70))
print(get_grade(55))
print(get_grade(40))

